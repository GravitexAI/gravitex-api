  "common_errors": {
    "MissingParameter_input_status": {
      "error_message": "The request failed because it is missing `***.status` parameter",
      "error_code": "MissingParameter",
      "param": "input.status",
      "cause": "使用完整格式(Full Items)时, assistant 消息或 function_call 缺少 status 字段",
      "affected_providers": ["volcengine (火山引擎/豆包/seed模型)"],
      "fix": "方案一: 改用简写格式(Easy Input), content 用纯字符串; 方案二: 给 assistant 消息和 function_call 加上 \"status\": \"completed\" 以及 \"type\": \"message\""
    }
  }
