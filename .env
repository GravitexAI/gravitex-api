# 端口号
PORT=3003
# 前端基础URL
# FRONTEND_BASE_URL=https://your-frontend-url.com
FRONTEND_BASE_URL=http://localhost:5667


# 调试相关配置
# 启用pprof
ENABLE_PPROF=true
# 启用调试模式
DEBUG=true
ERROR_LOG_ENABLED=true
ENABLE_TASK_POLLING=false
DISABLE_PERFORMANCE_CHECK=true

# Sa-Token配置
SA_TOKEN_SECRET=abcdefghijklmnopqrstuvwxyz
RUOYI_AUTH_ENABLED=true
RUOYI_JWT_SECRET=abcdefghijklmnopqrstuvwxyz


#OSS_BASE64_ENDPOINT=http://localhost:8080/resource/oss/uploadByBase64
# OSS_BASE64_ENDPOINT=https://ai-nebula.com/prod-api/resource/oss/uploadByBase64

# 数据库相关配置
# SQL_DSN=root:Cxx123456@tcp(rm-7xvok30hhg97730a3ho.mysql.rds.aliyuncs.com:3306)/gravitex_api?parseTime=true
#SQL_DSN=root:Gravitex2026@tcp(mysql-1c3abdf6bcb0-public.rds.bytepluses.com:3306)/gravitex_api?parseTime=true
SQL_DSN=root:Gravitex2026@tcp(mysql-1c3abdf6bcb0-public.rds.bytepluses.com:3306)/gravitex_api?parseTime=true

# OSS_BASE64_ENDPOINT=https://ai-nebula.com/prod-api/resource/oss/uploadByBase64

# 日志数据库连接字符串
# LOG_SQL_DSN=user:password@tcp(127.0.0.1:3306)/logdb?parseTime=true
# SQLite数据库路径
# SQLITE_PATH=/path/to/sqlite.db
# 数据库最大空闲连接数
# SQL_MAX_IDLE_CONNS=100
# 数据库最大打开连接数
# SQL_MAX_OPEN_CONNS=1000
# 数据库连接最大生命周期（秒）
# SQL_MAX_LIFETIME=60
# 缓存相关配置
# Redis连接字符串
# REDIS_CONN_STRING=redis://user:password@localhost:6379/0
# REDIS_CONN_STRING=redis://FXa%256g83-m3@redis-mlrfidzhj48zhy87a.redis.ibytepluses.com:6379/0
REDIS_CONN_STRING=redis://:h7j4kab0wt5@redis-mlrfidzhj48zhy87a.redis.bytepluses.com:6379/0
REDIS_POOL_SIZE=500

# 同步频率（单位：秒）
# SYNC_FREQUENCY=60
# 内存缓存启用
# MEMORY_CACHE_ENABLED=true
# 渠道更新频率（单位：秒）
# CHANNEL_UPDATE_FREQUENCY=30
# 批量更新启用
# BATCH_UPDATE_ENABLED=true
# 批量更新间隔（单位：秒）
# BATCH_UPDATE_INTERVAL=5
# 任务和功能配置
# 更新任务启用
SQL_SKIP_MIGRATION=true

# 会话密钥（必需，请设置为随机字符串）
SESSION_SECRET=your_random_session_secret_for_development_12345

# 对话超时设置
# 所有请求超时时间，单位秒，默认为0，表示不限制
# RELAY_TIMEOUT=0
# 流模式无响应超时时间，单位秒，如果出现空补全可以尝试改为更大值
# STREAMING_TIMEOUT=120

# Gemini 识别图片 最大图片数量
# GEMINI_VISION_MAX_IMAGE_NUM=16

# 会话密钥
# SESSION_SECRET=random_string

# 其他配置
# 渠道测试频率（单位：秒）
# CHANNEL_TEST_FREQUENCY=10
# 生成默认token
# GENERATE_DEFAULT_TOKEN=false
# Cohere 安全设置k
# COHERE_SAFETY_SETTING=NONE
# 是否统计图片token
# GET_MEDIA_TOKEN=true
# 是否在非流（stream=false）情况下统计图片token
# GET_MEDIA_TOKEN_NOT_STREAM=true
# 设置 Dify 渠道是否输出工作流和节点信息到客户端
# DIFY_DEBUG=true


# 节点类型
# 如果是主节点则为master
# NODE_TYPE=master
